# Copy to backend/.env and fill in.

# Postgres + PostGIS. Local: the docker compose database below.
# Supabase: Project Settings → Database → Connection string (URI, session pooler).
DATABASE_URL=postgresql://safewalk:safewalk@localhost:5432/safewalk

# Google Gemini key for AI photo classification (https://aistudio.google.com/apikey).
# Leave empty to disable AI suggestions; users then pick the type themselves.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Photo storage. If both are set, photos go to the Supabase Storage bucket
# (create a PUBLIC bucket with this name first). Otherwise they're saved to backend/uploads/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=report-photos

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
